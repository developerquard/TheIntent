# /etc/systemd/system/the-intent.service
# Run the built Node server as a systemd service (alternative to PM2/Docker).
[Unit]
Description=The Intent - intent-based social platform
After=network.target

[Service]
Type=simple
WorkingDirectory=/var/www/the-intent
EnvironmentFile=/var/www/the-intent/.env
ExecStart=/usr/bin/node .output/server/index.mjs
Restart=on-failure
RestartSec=5
User=www-data
Group=www-data

[Install]
WantedBy=multi-user.target
