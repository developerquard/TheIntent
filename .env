# ==========================================================
# The Intent — Production env for self-hosting (Hostinger KVM2)
# Copy this file to `.env` on your server and keep it out of git.
# These values point the app at YOUR OWN Supabase project.
# ==========================================================

NODE_ENV=production
PORT=5173

# Nitro output preset — builds a plain Node server for a VPS.
NITRO_PRESET=node_server

# ---------- Database (your Supabase Postgres) ----------
DATABASE_URL=postgresql://postgres.laxyyifsboedsccqnfhc:theintent:social@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# ---------- Supabase server-side ----------
SUPABASE_URL=https://laxyyifsboedsccqnfhc.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_LZ4Ne4q27t4BBFDrl2lO3Q_ZtIS5ONI
# client.server.ts reads SUPABASE_SERVICE_ROLE_KEY. Your secret key goes here:
SUPABASE_SERVICE_ROLE_KEY=sb_secret_W46hZqYvhXxyoZjHBQpSFA_oS_usk-e

# ---------- Supabase client-side (baked in at BUILD time) ----------
# These must be present when you run `npm run build` on the server.
VITE_SUPABASE_URL=https://laxyyifsboedsccqnfhc.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_LZ4Ne4q27t4BBFDrl2lO3Q_ZtIS5ONI
VITE_SUPABASE_PROJECT_ID=laxyyifsboedsccqnfhc

# ---------- App domain (CORS / redirects) ----------
APP_DOMAIN=https://localhost:5173

# ---------- Optional: TURN server (restrictive networks / strict NAT) ----------
# WebRTC calls fall back to a TURN relay when direct/STUN connectivity fails.
# Leave blank to use STUN only. Baked in at BUILD time (VITE_*).
# Providers: self-hosted coturn, Twilio, Metered, Cloudflare Calls, etc.
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
